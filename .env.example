# =============================================================================
# polymarket_hybrid_bot — environment template (v0.2.1)
# Copy to .env and fill secrets:  cp .env.example .env && chmod 600 .env
# The running app reads BOT_* variables (pydantic-settings). Align POLY_* with
# those where noted.
# =============================================================================

# --- Polymarket signing (documentation aliases) ------------------------------
# Set BOT_POLYMARKET_PRIVATE_KEY to the same hex key as POLY_PK for live mode.
POLY_PK=
POLY_FUNDER=
POLY_SIGNATURE_TYPE=1
POLY_HOST=https://clob.polymarket.com
POLY_CHAIN_ID=137
POLY_RPC_URL=https://polygon-rpc.com

# --- Same values as consumed by the bot (required for live) ----------------
BOT_MODE=sim
BOT_EXPERIMENT_ID=default
BOT_LOG_LEVEL=INFO
BOT_POLYMARKET_HOST=https://clob.polymarket.com
BOT_POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
BOT_POLYMARKET_PRIVATE_KEY=
BOT_POLYMARKET_API_KEY=
BOT_POLYMARKET_API_SECRET=
BOT_POLYMARKET_API_PASSPHRASE=
BOT_POLYGON_RPC_URL=https://polygon-rpc.com
BOT_CHAIN_ID=137

# --- Paths inside Docker (see docker-compose volume mounts) ----------------
BOT_DATA_DIR=/app/data
BOT_LOG_DIR=/app/logs
BOT_REPORT_DIR=/app/data/reports

# --- Known-issue toggles (documented; not all are wired in application code) ---
# DISABLE_BINANCE_FEED=1 — Use when Binance returns HTTP 451 (geo-blocked US /
# many DigitalOcean regions). Prefer EU/SG regions for live Binance, or disable
# and rely on Polymarket midpoint / REST until a diversified reference feed lands.
DISABLE_BINANCE_FEED=1

# SUPPRESS_WS_404_WARNINGS=1 — Polymarket WS upgrade may return 404; the bot
# falls back to REST polling. Set to reduce log noise once you accept degraded WS.
SUPPRESS_WS_404_WARNINGS=0

# --- Optional: metrics, settlement poll, feeds (defaults are sane for sim) ---
BOT_METRICS_ENABLED=true
BOT_METRICS_PORT=9091
BOT_RESOLUTION_POLL_SECONDS=60
BOT_BINANCE_SYMBOLS=["BTC/USDT","ETH/USDT","SOL/USDT"]
BOT_COINBASE_SYMBOLS=["BTC/USD","ETH/USD","SOL/USD"]
