# ── Runtime ───────────────────────────────────────────────────────────────
BOT_MODE=sim                        # sim | live  (always start with sim)
BOT_EXPERIMENT_ID=default           # set to arm_a / arm_b / etc. for A/B runs
BOT_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
BOT_POLL_INTERVAL_SEC=0.25
BOT_STRATEGY_INTERVAL_SEC=0.20
BOT_SIM_SLIPPAGE_BPS=5              # paper-trading slippage in basis points
# Live fill reconciliation (REST fallback — used when user WS is unavailable in SDK)
BOT_FILL_POLL_INTERVAL_SEC=2
BOT_FILL_POLL_TIMEOUT_SEC=60
# Settlement: REST poll interval for Polymarket market resolutions (seconds)
BOT_RESOLUTION_POLL_SECONDS=60

# Prometheus OpenMetrics /metrics (Grafana, Datadog, etc.)
BOT_METRICS_ENABLED=true            # set false to disable background HTTP server entirely
BOT_METRICS_PORT=9091               # bind address is 0.0.0.0 inside container

# On-chain equity reconciliation (USDC vs RiskManager.equity, Prompt 9)
BOT_RECONCILIATION_INTERVAL_SECONDS=3600
BOT_RECONCILIATION_DRIFT_THRESHOLD_PCT=1.0
# Optional: override Polygon checksummed address; otherwise derived from BOT_POLYMARKET_PRIVATE_KEY
BOT_POLYGON_WALLET_ADDRESS=

# ── Polymarket CLOB API ───────────────────────────────────────────────────
BOT_POLYMARKET_HOST=https://clob.polymarket.com
BOT_POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/
BOT_POLYMARKET_PRIVATE_KEY=         # your wallet private key (L1 EOA)
BOT_POLYMARKET_API_KEY=             # L2 API key (from Polymarket dashboard)
BOT_POLYMARKET_API_SECRET=
BOT_POLYMARKET_API_PASSPHRASE=

# ── Spot feeds (ccxt.pro) ─────────────────────────────────────────────────
BOT_BINANCE_SYMBOLS=["BTC/USDT","ETH/USDT","SOL/USDT"]
BOT_COINBASE_SYMBOLS=["BTC/USD","ETH/USD","SOL/USD"]

# ── Polygon RPC (Layer 4, optional) ──────────────────────────────────────
BOT_POLYGON_RPC_URL=                # QuickNode / Alchemy Polygon mainnet URL
BOT_CHAIN_ID=137

# ── Risk parameters ───────────────────────────────────────────────────────
BOT_RISK_BANKROLL_USD=10000
BOT_RISK_MAX_TRADE_PCT=0.08         # max 8% equity per trade (5–10% range)
BOT_RISK_DAILY_DRAWDOWN_LIMIT_PCT=0.12   # kill-switch at 12% daily loss
BOT_RISK_KELLY_FRACTION=0.25        # quarter-Kelly (conservative)
BOT_RISK_MAX_PAIR_CORRELATION=0.80
BOT_RISK_MAX_OPEN_POSITIONS=8
BOT_RISK_MIN_ORDER_USD=10.0         # ignore sub-$10 dust orders

# ── Strategy parameters ───────────────────────────────────────────────────
BOT_STRAT_MOMENTUM_ENABLED=true
BOT_STRAT_MARKET_MAKER_ENABLED=true
BOT_STRAT_SMART_MONEY_ENABLED=false         # Layer 4 — off by default
BOT_STRAT_SMART_MONEY_MIN_WIN_RATE=0.60
BOT_STRAT_SMART_MONEY_MIN_PROFIT_FACTOR=1.50
BOT_STRAT_MIN_LIQUIDITY_USD=5000
BOT_STRAT_MIN_ARB_EDGE=0.005        # min guaranteed edge after fees
BOT_STRAT_MOMENTUM_Z_THRESHOLD=2.0
BOT_STRAT_MOMENTUM_WINDOW=60
BOT_STRAT_MM_SPREAD_BPS=40

# ── Alerts (optional — leave blank to disable) ────────────────────────────
BOT_TELEGRAM_TOKEN=                 # from @BotFather
BOT_TELEGRAM_CHAT_ID=               # your chat/channel ID
BOT_DISCORD_WEBHOOK_URL=            # Discord channel webhook URL

